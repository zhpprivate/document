<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0"><diagram id="department-improvement" name="责任与交付闭环"><mxGraphModel dx="1600" dy="1060" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1060" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="研发协作：现有人员如何完成一次交付" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=34;fontColor=#20354D;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="24" width="1450" height="50" /></mxCell><mxCell id="3" value="建议方案 · 人员落实 · 容量同步安排" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=19;fontColor=#516277;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="77" width="470" height="30" /></mxCell><mxCell id="4" value="&lt;b&gt;总监｜方向、授权与重大审批&lt;/b&gt;&lt;br&gt;批准目标、预算及重大资源投入" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#F5F5F5;strokeColor=#8C9CAD;strokeWidth=1.5;fontSize=20;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="116" width="460" height="88" /></mxCell><mxCell id="5" value="&lt;b&gt;部门交付统筹人｜人选待定&lt;/b&gt;&lt;br&gt;到位并获授权后：统筹资源、排期和试任" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=20;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="116" width="480" height="88" /></mxCell><mxCell id="6" value="&lt;b&gt;空缺状态｜人员与授权待落实&lt;/b&gt;&lt;br&gt;暂缓新的跨系统交付承诺" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#F5F5F5;strokeColor=#8C9CAD;strokeWidth=1.5;fontSize=20;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="116" width="460" height="88" /></mxCell><mxCell id="7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="5"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="8" value="&lt;b&gt;牵头产品｜优先从现有产品中试任&lt;/b&gt;&lt;br&gt;核实能力与容量，兼任版本交付负责人&lt;br&gt;范围、整体排期、依赖跟踪与验收" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=20;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="270" width="460" height="115" /></mxCell><mxCell id="9" value="&lt;b&gt;现有架构师｜跨系统技术负责人&lt;/b&gt;&lt;br&gt;裁定接口、数据与重大技术方案&lt;br&gt;设关键检查点，验证技术决定落实" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=20;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="270" width="480" height="115" /></mxCell><mxCell id="10" value="&lt;b&gt;各组实施｜现有组长与测试组长&lt;/b&gt;&lt;br&gt;组长承诺并落实本组开发任务&lt;br&gt;测试组长分配测试、确认质量结论" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=20;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="270" width="460" height="115" /></mxCell><mxCell id="11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.2;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="8"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="656" y="235" /><mxPoint x="270" y="235" /></Array></mxGeometry></mxCell><mxCell id="12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="9"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.8;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="10"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="944" y="235" /><mxPoint x="1330" y="235" /></Array></mxGeometry></mxCell><mxCell id="14" value="&lt;b&gt;版本小组｜现有产品、各组开发与固定系统测试&lt;/b&gt;&lt;br&gt;试点：同一产品最多牵头 1 个跨系统版本，预留约 30% 时间并减少其他需求任务&lt;br&gt;前端、移动端纳入对应组；共享人员统一记入容量表；每版有 1 名测试对接人" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#F5F5F5;strokeColor=#8C9CAD;strokeWidth=1.5;fontSize=20;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="452" width="1520" height="110" /></mxCell><mxCell id="15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.1513157894736842;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="8" target="14"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="16" value="版本计划与跨组协作" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=18;fontColor=#516277;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="408" width="410" height="26" /></mxCell><mxCell id="17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="9" target="14"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="18" value="技术决定与关键检查" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=18;fontColor=#516277;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="580" y="408" width="440" height="26" /></mxCell><mxCell id="19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.8486842105263158;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="10" target="14"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="20" value="任务承诺与质量验证" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=18;fontColor=#516277;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1115" y="408" width="430" height="26" /></mxCell><mxCell id="21" value="同一位交付牵头人持续跟踪：需求、开发、测试与上线" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#20354D;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="595" width="1450" height="35" /></mxCell><mxCell id="22" value="按主业务归属优先试任产品；两周复核；人选不适配或缺位时，执行人员试任与调整机制" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#516277;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="634" width="1490" height="30" /></mxCell><mxCell id="23" value="&lt;b&gt;01  需求就绪&lt;/b&gt;&lt;br&gt;牵头产品准备&lt;br&gt;目标、范围、验收&lt;br&gt;逐项澄清与放行" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=19;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="685" width="220" height="150" /></mxCell><mxCell id="24" value="&lt;b&gt;02  共同排期&lt;/b&gt;&lt;br&gt;开发与测试估算&lt;br&gt;组长确认容量&lt;br&gt;产品汇总并报批" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=19;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="300" y="685" width="220" height="150" /></mxCell><mxCell id="25" value="&lt;b&gt;03  推进与协调&lt;/b&gt;&lt;br&gt;产品维护看板&lt;br&gt;组长落实任务&lt;br&gt;技术争议交架构师" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#F5F5F5;strokeColor=#8C9CAD;strokeWidth=1.5;fontSize=19;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="685" width="220" height="150" /></mxCell><mxCell id="26" value="&lt;b&gt;04  验证与上线&lt;/b&gt;&lt;br&gt;测试给验证结论&lt;br&gt;产品组织业务验收&lt;br&gt;组长发布并验证" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#F5F5F5;strokeColor=#8C9CAD;strokeWidth=1.5;fontSize=19;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="685" width="220" height="150" /></mxCell><mxCell id="27" value="&lt;b&gt;05  演示与改进&lt;/b&gt;&lt;br&gt;产品演示业务成果&lt;br&gt;组长与架构师改进&lt;br&gt;纳入下轮容量表" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#F5F5F5;strokeColor=#8C9CAD;strokeWidth=1.5;fontSize=19;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1080" y="685" width="220" height="150" /></mxCell><mxCell id="28" value="&lt;b&gt;06  绩效复核&lt;/b&gt;&lt;br&gt;期初先约定标准&lt;br&gt;期末按事实评价&lt;br&gt;有异议可复核" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#F5F5F5;strokeColor=#8C9CAD;strokeWidth=1.5;fontSize=19;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="685" width="220" height="150" /></mxCell><mxCell id="29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="23" target="24"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="24" target="25"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="25" target="26"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=1;exitY=0.5;entryX=