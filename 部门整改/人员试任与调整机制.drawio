<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0"><diagram id="department-improvement" name="人员试任与调整机制"><mxGraphModel dx="1600" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1120" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="人员调整：试任、支持、复核与交接" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=34;fontColor=#20354D;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="22" width="1500" height="50" /></mxCell><mxCell id="3" value="交付统筹人人选待定；图示为人选及授权落实后的处理流程" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#516277;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="78" width="1520" height="32" /></mxCell><mxCell id="4" value="&lt;b&gt;交付统筹人到位后组织试任与备份&lt;/b&gt;&lt;br&gt;范围、授权、容量、验收标准、两周复核日期" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=20;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="500" y="132" width="600" height="100" /></mxCell><mxCell id="5" value="&lt;b&gt;相关主管核实条件与事实&lt;/b&gt;&lt;br&gt;任务记录 + 员工说明 + 专业评审&lt;br&gt;开发由组长、测试由测试组长，负责人由交付统筹人组织复核" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#F5F5F5;strokeColor=#8C9CAD;strokeWidth=1.5;fontSize=20;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="304" width="720" height="118" /></mxCell><mxCell id="6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="5"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="7" value="&lt;b&gt;授权或资源未就绪&lt;/b&gt;&lt;br&gt;主管澄清职责与冲突&lt;br&gt;交付统筹人在授权内调配&lt;br&gt;更新计划后继续试任" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=19;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="515" width="350" height="154" /></mxCell><mxCell id="8" value="&lt;b&gt;能力或职责适配有差距&lt;/b&gt;&lt;br&gt;指定导师，辅导 2–4 周&lt;br&gt;每周反馈，按样例复核&lt;br&gt;关键风险先安排合格代岗" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=19;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="515" width="350" height="154" /></mxCell><mxCell id="9" value="&lt;b&gt;约定协作行为持续未落实&lt;/b&gt;&lt;br&gt;核实记录与员工说明&lt;br&gt;明确改进项和复核日期&lt;br&gt;仍重复时按既定规则处理" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=19;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="515" width="350" height="154" /></mxCell><mxCell id="10" value="&lt;b&gt;暂缺合适交付负责人&lt;/b&gt;&lt;br&gt;主责产品 → 其他合格产品&lt;br&gt;合格组长减负后临时代任&lt;br&gt;仍无承接人：待定并暂缓承诺" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=19;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1210" y="515" width="350" height="154" /></mxCell><mxCell id="11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0;exitY=0.5;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="7"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="215" y="363" /></Array></mxGeometry></mxCell><mxCell id="12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.25;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="8"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="620" y="463" /><mxPoint x="605" y="463" /></Array></mxGeometry></mxCell><mxCell id="13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.75;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="9"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="980" y="463" /><mxPoint x="995" y="463" /></Array></mxGeometry></mxCell><mxCell id="14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=1;exitY=0.5;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="10"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1385" y="363" /></Array></mxGeometry></mxCell><mxCell id="15" value="&lt;b&gt;交付统筹人按授权复核并安排职责&lt;/b&gt;&lt;br&gt;继续试任 / 辅导后续任 / 收窄职责 / 更换负责人 / 申请补充人员&lt;br&gt;无法覆盖的高风险工作先暂停；内部调入或招聘按实际能力缺口与容量决策" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#F5F5F5;strokeColor=#8C9CAD;strokeWidth=1.5;fontSize=20;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="761" width="1520" height="112" /></mxCell><mxCell id="16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.11513157894736842;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7" target="15"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.3717105263157895;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="8" target="15"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.6282894736842105;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="9" target="15"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.8848684210526315;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="10" target="15"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="20" value="&lt;b&gt;落实决定｜续任更新安排，换人完成交接&lt;/b&gt;&lt;br&gt;换人须明确生效时间，移交计划、依赖、风险、决策与未完成项&lt;br&gt;各组重新确认容量与日期；一名交付负责人；原承诺与变更记录保留" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=20;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="350" y="949" width="900" height="112" /></mxCell><mxCell id="21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="15" target="20"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;dashed=1;dashPattern=7 5;" edge="1" parent="1" source="20" target="4"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="20" y="1005" /><mxPoint x="20" y="182" /></Array></mxGeometry></mxCell><mxCell id="23" value="统筹人未到位：暂缓新的跨系统承诺；岗位及薪酬变更另走公司授权程序。" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=18;fontColor=#516277;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1080" width="1520" height="26" /></mxCell></root></mxGraphModel></diagram></mxfile>