<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0"><diagram id="department-improvement" name="责任与交付闭环"><mxGraphModel dx="1600" dy="1060" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1060" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="部门整改：责任明确，交付闭环" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=34;fontColor=#20354D;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="24" width="1250" height="50" /></mxCell><mxCell id="3" value="建议方案 · 现有岗位授权 · 先试点 60 天" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=19;fontColor=#516277;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="77" width="470" height="30" /></mxCell><mxCell id="4" value="&lt;b&gt;总监｜方向、容量与最终取舍&lt;/b&gt;&lt;br&gt;全员目标对齐 · 跨组资源冲突裁决" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=20;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="116" width="480" height="88" /></mxCell><mxCell id="5" value="&lt;b&gt;产品总负责人｜整体业务&lt;/b&gt;&lt;br&gt;统一需求排序与平台路线图&lt;br&gt;各系统产品负责需求与业务验收" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=20;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="270" width="460" height="115" /></mxCell><mxCell id="6" value="&lt;b&gt;唯一交付负责人｜本次交付&lt;/b&gt;&lt;br&gt;依赖承诺、进度、风险与上线闭环&lt;br&gt;获授权召集协作，冲突升级总监" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=20;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="270" width="480" height="115" /></mxCell><mxCell id="7" value="&lt;b&gt;架构师｜整体技术&lt;/b&gt;&lt;br&gt;跨系统方案、共性能力与技术债&lt;br&gt;普通变更授权系统技术负责人" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=20;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="270" width="460" height="115" /></mxCell><mxCell id="8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.2;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="5"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="656" y="235" /><mxPoint x="270" y="235" /></Array></mxGeometry></mxCell><mxCell id="9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="6"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.8;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="7"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="944" y="235" /><mxPoint x="1330" y="235" /></Array></mxGeometry></mxCell><mxCell id="11" value="&lt;b&gt;系统协作单元｜长期管系统，共同完成需求&lt;/b&gt;&lt;br&gt;系统产品负责人 + 系统技术负责人／开发 + 测试&lt;br&gt;前端、移动端与共享测试按实际容量参与；兼任负责人须减少原有任务" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#F5F5F5;strokeColor=#8C9CAD;strokeWidth=1.5;fontSize=20;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="452" width="1520" height="110" /></mxCell><mxCell id="12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.1513157894736842;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="11"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="13" value="范围与验收" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=18;fontColor=#516277;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="408" width="410" height="26" /></mxCell><mxCell id="14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="6" target="11"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="15" value="整体验收上线与依赖跟踪" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=18;fontColor=#516277;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="580" y="408" width="440" height="26" /></mxCell><mxCell id="16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.8486842105263158;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7" target="11"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="17" value="标准与跨系统方案" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=18;fontColor=#516277;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1115" y="408" width="430" height="26" /></mxCell><mxCell id="18" value="交付流程｜一张看板，逐项推进" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#20354D;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="595" width="900" height="35" /></mxCell><mxCell id="19" value="已就绪且可独立交付的需求先做；未就绪项回补；测试从需求阶段参与" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#516277;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="634" width="1490" height="30" /></mxCell><mxCell id="20" value="&lt;b&gt;01  持续澄清&lt;/b&gt;&lt;br&gt;产品牵头&lt;br&gt;目标、范围、验收&lt;br&gt;确认依赖后可排期" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=19;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="685" width="220" height="150" /></mxCell><mxCell id="21" value="&lt;b&gt;02  联合排期&lt;/b&gt;&lt;br&gt;开发、测试估算&lt;br&gt;各组确认容量&lt;br&gt;交付负责人汇总" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=19;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="300" y="685" width="220" height="150" /></mxCell><mxCell id="22" value="&lt;b&gt;03  开发与联调&lt;/b&gt;&lt;br&gt;开发负责质量&lt;br&gt;自测、同行评审&lt;br&gt;当天暴露延期风险" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#F5F5F5;strokeColor=#8C9CAD;strokeWidth=1.5;fontSize=19;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="685" width="220" height="150" /></mxCell><mxCell id="23" value="&lt;b&gt;04  验证与验收&lt;/b&gt;&lt;br&gt;测试给质量结论&lt;br&gt;产品确认业务验收&lt;br&gt;严重缺陷阻断发布" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#F5F5F5;strokeColor=#8C9CAD;strokeWidth=1.5;fontSize=19;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="685" width="220" height="150" /></mxCell><mxCell id="24" value="&lt;b&gt;05  发布与观察&lt;/b&gt;&lt;br&gt;技术负责人执行&lt;br&gt;回滚与上线验证&lt;br&gt;交付负责人跟到底" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#F5F5F5;strokeColor=#8C9CAD;strokeWidth=1.5;fontSize=19;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1080" y="685" width="220" height="150" /></mxCell><mxCell id="25" value="&lt;b&gt;06  演示与复盘&lt;/b&gt;&lt;br&gt;产品验证效果&lt;br&gt;团队复盘改进&lt;br&gt;进入下一轮排期" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#F5F5F5;strokeColor=#8C9CAD;strokeWidth=1.5;fontSize=19;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="685" width="220" height="150" /></mxCell><mxCell id="26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="20" target="21"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="21" target="22"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="22" target="23"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="23" target="24"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="24" target="25"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.35;exitY=1;entryX=0.7;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;dashed=1;dashPattern=7 5;" edge="1" parent="1" source="23" target="22"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="897" y="883" /><mxPoint x="714" y="883" /></Array></mxGeometry></mxCell><mxCell id="32" value="验收不通过：修复后重新验证" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=19;fontColor=#516277;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="864" width="410" height="30" /></mxCell><mxCell id="33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;dashed=1;dashPattern=7 5;" edge="1" parent="1" source="25" target="20"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1450" y="945" /><mxPoint x="150" y="945" /></Array></mxGeometry></mxCell><mxCell id="34" value="复盘改进与用户反馈 → 下一轮需求与优化" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=21;fontColor=#516277;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="405" y="903" width="790" height="30" /></mxCell><mxCell id="35" value="执行原则：限制并行｜插单同步取舍｜先建数据基线｜认可协作与改进" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=22;fontColor=#20354D;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="978" width="1520" height="32" /></mxCell><mxCell id="36" value="箭头表示授权、协作与工作推进，不表示新增行政层级；虚线表示反馈与返工。" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=17;fontColor=#516277;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1020" width="1520" height="24" /></mxCell></root></mxGraphModel></diagram></mxfile>