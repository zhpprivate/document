<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0"><diagram id="department-improvement" name="人员试任与调整机制"><mxGraphModel dx="1600" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1120" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="人员调整：先试任，查清问题再调整" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=34;fontColor=#20354D;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="22" width="1500" height="50" /></mxCell><mxCell id="3" value="统筹人人选待定；确定人选和授权后，按以下流程执行" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#516277;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="78" width="1520" height="32" /></mxCell><mxCell id="4" value="&lt;b&gt;统筹人到位后，安排试任和备份&lt;/b&gt;&lt;br&gt;定范围、权限、可用时间和验收标准，两周后复核" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=20;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="500" y="132" width="600" height="100" /></mxCell><mxCell id="5" value="&lt;b&gt;相关主管查清问题&lt;/b&gt;&lt;br&gt;查看任务记录，听取员工说明，进行专业评审&lt;br&gt;开发由组长复核，测试由测试组长复核，负责人由统筹人组织复核" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#F5F5F5;strokeColor=#8C9CAD;strokeWidth=1.5;fontSize=20;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="304" width="720" height="118" /></mxCell><mxCell id="6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="5"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="7" value="&lt;b&gt;权限或资源没落实&lt;/b&gt;&lt;br&gt;主管查清职责和冲突&lt;br&gt;统筹人在授权内调整安排&lt;br&gt;更新计划后继续试任" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=19;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="515" width="350" height="154" /></mxCell><mxCell id="8" value="&lt;b&gt;能力不足或职责不合适&lt;/b&gt;&lt;br&gt;指定导师，辅导 2 至 4 周&lt;br&gt;每周反馈，按样例检查&lt;br&gt;高风险职责先由合格人员代岗" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=19;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="515" width="350" height="154" /></mxCell><mxCell id="9" value="&lt;b&gt;约定的配合反复没做到&lt;/b&gt;&lt;br&gt;查记录，听取员工说明&lt;br&gt;写清改进要求和复核日期&lt;br&gt;仍反复出现，按既定规则处理" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=19;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="515" width="350" height="154" /></mxCell><mxCell id="10" value="&lt;b&gt;找不到合适的交付负责人&lt;/b&gt;&lt;br&gt;先主责产品，再其他合格产品&lt;br&gt;再考虑合格组长减负后代任&lt;br&gt;仍没人能接：待定，暂不承诺" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=19;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1210" y="515" width="350" height="154" /></mxCell><mxCell id="11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0;exitY=0.5;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="7"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="215" y="363" /></Array></mxGeometry></mxCell><mxCell id="12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.25;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="8"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="620" y="463" /><mxPoint x="605" y="463" /></Array></mxGeometry></mxCell><mxCell id="13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.75;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="9"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="980" y="463" /><mxPoint x="995" y="463" /></Array></mxGeometry></mxCell><mxCell id="14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=1;exitY=0.5;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="10"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1385" y="363" /></Array></mxGeometry></mxCell><mxCell id="15" value="&lt;b&gt;统筹人在授权内复核，决定职责怎么调整&lt;/b&gt;&lt;br&gt;继续试任 / 辅导后续任 / 缩小职责范围 / 更换负责人 / 申请补人&lt;br&gt;没人能承担的高风险工作先暂停；是否内部调入或招聘，看缺什么能力、多少人力" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#F5F5F5;strokeColor=#8C9CAD;strokeWidth=1.5;fontSize=20;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="761" width="1520" height="112" /></mxCell><mxCell id="16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.11513157894736842;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7" target="15"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.3717105263157895;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="8" target="15"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.6282894736842105;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="9" target="15"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.8848684210526315;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="10" target="15"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="20" value="&lt;b&gt;继续任职就更新安排，换人就完成交接&lt;/b&gt;&lt;br&gt;换人要定生效时间，移交计划、配合事项、风险、决策和未完成项&lt;br&gt;各组重新确认可用时间和日期；负责人只留一名，保留原承诺和变更记录" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=20;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="350" y="949" width="900" height="112" /></mxCell><mxCell id="21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="15" target="20"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;dashed=1;dashPattern=7 5;" edge="1" parent="1" source="20" target="4"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="20" y="1005" /><mxPoint x="20" y="182" /></Array></mxGeometry></mxCell><mxCell id="23" value="统筹人未到位，暂缓新的跨系统承诺；岗位和薪酬变更另走公司授权程序。" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=18;fontColor=#516277;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1080" width="1520" height="26" /></mxCell></root></mxGraphModel></diagram></mxfile>