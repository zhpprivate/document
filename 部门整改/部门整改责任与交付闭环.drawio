<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0"><diagram id="department-improvement" name="责任与交付闭环"><mxGraphModel dx="1600" dy="1160" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1160" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="跨系统交付：各阶段交什么、谁验收" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=34;fontColor=#20354D;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="24" width="1490" height="50" /></mxCell><mxCell id="3" value="流程建议：验收通过再进入下一步，只暂停受影响的事项" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#516277;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="80" width="1520" height="32" /></mxCell><mxCell id="4" value="&lt;b&gt;跨系统试点前：确定统筹人、验收人和权限&lt;/b&gt;&lt;br&gt;统筹人人选待定；总监负责方向、授权和重大审批；流程权限须在试点前验证" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#F5F5F5;strokeColor=#8C9CAD;strokeWidth=1.5;fontSize=20;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="139" width="1520" height="86" /></mxCell><mxCell id="5" value="&lt;b&gt;产品写清需求&lt;/b&gt;&lt;br&gt;业务目标、范围与规则&lt;br&gt;正常及异常验收示例&lt;br&gt;材料与需求版本一致" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=19;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="278" width="350" height="142" /></mxCell><mxCell id="6" value="&lt;b&gt;组长查估算，架构师定方案&lt;/b&gt;&lt;br&gt;组长：估算依据、人员安排&lt;br&gt;架构师：需要其决策的方案&lt;br&gt;参与组确认配合事项和接口" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=19;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="278" width="350" height="142" /></mxCell><mxCell id="7" value="&lt;b&gt;开发交代码和自测结果&lt;/b&gt;&lt;br&gt;代码变更与自测结果&lt;br&gt;必要的自动检查结果&lt;br&gt;同行评审、关键功能验证" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=19;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="278" width="350" height="142" /></mxCell><mxCell id="8" value="&lt;b&gt;测试和发布人员交验证结果&lt;/b&gt;&lt;br&gt;当前版本的测试与业务验收&lt;br&gt;严重缺陷已解决，备好恢复方案&lt;br&gt;发布后记录上线验证结果" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=19;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1210" y="278" width="350" height="142" /></mxCell><mxCell id="9" value="&lt;b&gt;01  可排期&lt;/b&gt;&lt;br&gt;验收：测试对接人、组长&lt;br&gt;业务方确认业务规则&lt;br&gt;缺验收示例：继续澄清" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#F5F5F5;strokeColor=#8C9CAD;strokeWidth=1.5;fontSize=18;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="509" width="350" height="154" /></mxCell><mxCell id="10" value="&lt;b&gt;02  定日期，正式开发&lt;/b&gt;&lt;br&gt;验收：统筹人及技术同行&lt;br&gt;估算已查、人员和所需方案已定&lt;br&gt;缺少依据：不承诺日期" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#F5F5F5;strokeColor=#8C9CAD;strokeWidth=1.5;fontSize=18;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="509" width="350" height="154" /></mxCell><mxCell id="11" value="&lt;b&gt;03  可合并／可提测&lt;/b&gt;&lt;br&gt;同行查代码，测试确认能接收&lt;br&gt;评审、自测和必要检查通过&lt;br&gt;未通过：修复后重新提交" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#F5F5F5;strokeColor=#8C9CAD;strokeWidth=1.5;fontSize=18;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="509" width="350" height="154" /></mxCell><mxCell id="12" value="&lt;b&gt;04  可发布／可结项&lt;/b&gt;&lt;br&gt;测试、业务和技术检查通过&lt;br&gt;满足质量要求，备好恢复方案&lt;br&gt;上线未验证：不结项" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#F5F5F5;strokeColor=#8C9CAD;strokeWidth=1.5;fontSize=18;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1210" y="509" width="350" height="154" /></mxCell><mxCell id="13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="9"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="6" target="10"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7" target="11"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="8" target="12"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="9" target="10"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="10" target="11"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="11" target="12"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="20" value="&lt;b&gt;该做的检查未通过：停在这一步，写清问题和处理期限&lt;/b&gt;&lt;br&gt;不能独自验收自己的工作；缺席或逾期不自动通过；验收人要留下检查依据&lt;br&gt;超过 1 个工作日，由已到位的统筹人安排补齐材料、合格人员代验或调整范围" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=20;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="755" width="1520" height="110" /></mxCell><mxCell id="21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.11513157894736842;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;dashed=1;dashPattern=7 5;" edge="1" parent="1" source="9" target="20"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.3717105263157895;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;dashed=1;dashPattern=7 5;" edge="1" parent="1" source="10" target="20"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.6282894736842105;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;dashed=1;dashPattern=7 5;" edge="1" parent="1" source="11" target="20"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.5;exitY=1;entryX=0.8848684210526315;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;dashed=1;dashPattern=7 5;" edge="1" parent="1" source="12" target="20"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="25" value="&lt;b&gt;补齐材料，或由合格人员代验&lt;/b&gt;&lt;br&gt;回到对应步骤，重新验收&lt;br&gt;保留原记录、当前版本和验收结论" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#F5F5F5;strokeColor=#8C9CAD;strokeWidth=1.5;fontSize=20;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="946" width="740" height="105" /></mxCell><mxCell id="26" value="&lt;b&gt;没人能接，或关键条件仍不满足&lt;/b&gt;&lt;br&gt;暂停相关事项，调整范围或申请补人&lt;br&gt;严重质量问题不能豁免，独立工作可继续" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;rounded=1;arcSize=10;fillColor=#F5F5F5;strokeColor=#8C9CAD;strokeWidth=1.5;fontSize=20;fontColor=#20354D;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="946" width="740" height="105" /></mxCell><mxCell id="27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.25;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="20" target="25"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="420" y="905" /><mxPoint x="410" y="905" /></Array></mxGeometry></mxCell><mxCell id="28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#516277;strokeWidth=1.8;endArrow=open;endSize=10;exitX=0.75;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="20" target="26"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1180" y="905" /><mxPoint x="1190" y="905" /></Array></mxGeometry></mxCell><mxCell id="29" value="普通低风险变更按组内标准执行；跨系统或高风险事项才需要相应的架构检查。" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#516277;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1080" width="1520" height="30" /></mxCell><mxCell id="30" value="持续改进看实际使用和效果；未完成不能报完成，无关交付继续推进。虚线表示验收未通过。" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;horizontal=1;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=18;fontColor=#516277;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1120" width="1520" height="26" /></mxCell></root></mxGraphModel></diagram></mxfile>